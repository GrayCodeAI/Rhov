# Local direnv file (may hold personal keys for `make test-live`).
/.envrc

# Lefthook-generated git hook wrappers
.githooks/
__pycache__/
rho_bin

# Logs
*.log
rho-sec105b.log

# Compiled Go test binaries
*.test

# Agent instructions: this repo is AGENTS.md-only.
# `gitnexus analyze` regenerates a root CLAUDE.md that would shadow AGENTS.md
# for tools that prefer it; keep the regenerated copy out of git.
/CLAUDE.md
